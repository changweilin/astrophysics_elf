{
  "name": "kn-wiki-kb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wikipedia knowledge base for the Kerr-Newman Lab: polite crawler over astronomy/astrophysics/cosmology topics + scientists + history of science in 8 languages (zh-TW/en priority), Wikidata knowledge graph, hybrid BM25+vector RAG with time decay, CRUD admin, and a periodic update checker. Zero npm dependencies (node:sqlite + local Ollama embeddings).",
  "license": "GPL-3.0-or-later",
  "author": "Chang Wei Lin",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "crawl": "node crawl.mjs all",
    "discover": "node crawl.mjs discover",
    "fetch": "node crawl.mjs fetch",
    "langlinks": "node crawl.mjs langlinks",
    "graph": "node crawl.mjs graph",
    "embed": "node crawl.mjs embed",
    "status": "node crawl.mjs status",
    "update": "node check-updates.mjs --discover",
    "serve": "node server.mjs",
    "stats": "node kb-admin.mjs stats",
    "eval": "node eval/run-eval.mjs",
    "eval:retrieval": "node eval/run-eval.mjs --retrieval-only",
    "eval:baseline": "node eval/run-eval.mjs --retrieval-only --save-baseline",
    "eval:gate": "node eval/run-eval.mjs --retrieval-only --gate",
    "eval:ab": "node eval/run-eval.mjs --retrieval-only --ab",
    "test": "node eval/stats.test.mjs && node lib/query-route.test.mjs",
    "check": "node ../tools/check-syntax.mjs --quiet wiki-kb && npm test"
  },
  "dependencies": {
    "opencc-js": "^1.4.0"
  }
}
