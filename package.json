{
  "name": "kerr-newman-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Kerr-Newman Black Hole Laboratory browser demo, served as static files behind tailscale serve.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Chang Wei Lin",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node serve.mjs",
    "start:dist": "node dist/serve.mjs",
    "dev:all": "node dev-all.mjs",
    "dev:api": "node scientists-backend/server.mjs",
    "kb:crawl": "node wiki-kb/crawl.mjs all",
    "kb:update": "node wiki-kb/check-updates.mjs --discover",
    "kb:serve": "node wiki-kb/server.mjs",
    "kb:stats": "node wiki-kb/kb-admin.mjs stats",
    "start": "node serve.mjs",
    "check": "node tools/check-syntax.mjs --quiet",
    "test": "node test/run-all.mjs",
    "test:full": "node test/run-all.mjs --all",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.7"
  }
}
